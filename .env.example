# Copy to .env (ignored by Git). Never paste real secrets into model prompts.
# Only PostgreSQL/Neo4j passwords are needed to start Docker; the UI needs no env.
# Use strong unique local passwords. URL-encode credentials in DATABASE_URL.
POSTGRES_PASSWORD=
NEO4J_PASSWORD=

# Future integrations: intentionally unconfigured and unused by this scaffold.
# Replace the password segment to match POSTGRES_PASSWORD; keep it URL encoded.
DATABASE_URL=postgresql://sugarguard:REPLACE_WITH_URL_ENCODED_PASSWORD@localhost:5432/sugarguard
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
# NEO4J_PASSWORD above is used for both Docker initialization and future app access.

NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SIGNING_SECRET=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/onboarding
SARVAM_API_KEY=sk_5ivctt98_duIB1k4yDNBFKZMmlyPSFs7q
# Choose the LLM provider first; its server-only env names belong here later.
# Configure a per-device credential mechanism; do not use one fleet-wide secret.
